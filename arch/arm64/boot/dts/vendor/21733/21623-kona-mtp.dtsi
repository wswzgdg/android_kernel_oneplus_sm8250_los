#include "kona-mtp.dtsi" 

&soc {
    oplus_sensor {
        msensor@1 {
            soft-mag-parameter = <9995 0 268 1 185 1 48 1 8998 0 307 1 195 1 158 1 9932 0>;//e00 sign e01 sign ...
        };
    };
};

&qupv3_se13_i2c {
    black_gesture_indep_support;
    sportify_aod_gesture_support;
    switch_game_rate_support;
    report_rate_game_value = <1>;
};

&qupv3_se16_i2c {
    rk826_fastcg@0a {
        qcom,smart_chg_bcc_support;

        qcom,svooc_0_to_50_little_cold_stop_cur = <1000>;
		qcom,svooc_0_to_50_cold_stop_cur = <1000>;
		qcom,svooc_0_to_50_little_cool_stop_cur = <1100>;
		qcom,svooc_0_to_50_normal_low_stop_cur = <1100>;
		qcom,svooc_0_to_50_normal_high_stop_cur = <1300>;
		qcom,svooc_0_to_50_warm_stop_cur = <1300>;

		qcom,svooc_51_to_75_little_cold_stop_cur = <1000>;
		qcom,svooc_51_to_75_cold_stop_cur = <1000>;
		qcom,svooc_51_to_75_little_cool_stop_cur = <1000>;
