		qcom,svooc_86_to_90_little_cool_stop_cur = <1000>;
		qcom,svooc_86_to_90_normal_low_stop_cur = <1100>;
		qcom,svooc_86_to_90_normal_high_stop_cur = <1300>;

        svooc_charge_curve {
            strategy_soc_0_to_50 {
                strategy_temp_little_cold =	<4184 20 10 0
                                    4424 15 10 0
                                    4430 10 10 1>;
                strategy_temp_cool = <4184 25 15 0
                                    4424 20 10 0
                                    4430 10 10 1>;
                strategy_temp_little_cool = <4184 50 35 0
                                    4454 40 25 0
                                    4484 30 11 0
                                    4490 11 11 1>;
                strategy_temp_normal_low =	<4134 73 55 0
                                    4184 60 45 0
                                    4224 50 35 0
                                    4454 40 25 0
                                    4484 30 11 0
                                    4490 11 11 1>;
                strategy_temp_normal_high =	<4134 73 55 0
                                    4184 60 45 0
                                    4224 50 35 0
                                    4454 40 25 0
                                    4484 30 13 0
                                    4490 13 13 1>;
                strategy_temp_warm = <4130 13 13 1>;
            };

            strategy_soc_50_to_75 {
                strategy_temp_little_cold =	<4424 15 10 0
                                    4430 10 10 1>;
                strategy_temp_cool = <4424 20 10 0
                                    4430 10 10 1>;
                strategy_temp_little_cool =	<4454 40 25 0
                                    4484 30 10 0
                                    4490 10 10 1>;
                strategy_temp_normal_low = <4454 40 25 0
                                    4484 30 11 0
